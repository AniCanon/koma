--swiftversion 6.3
--indent 4
--allman false
--semicolons never
--commas inline
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--maxwidth 140
--stripunusedargs closure-only
--self remove
--ifdef no-indent
--disable redundantReturn,redundantMemberwiseInit
--exclude .build
